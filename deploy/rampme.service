# Installed on the Pi as /etc/systemd/system/rampme.service
#
# Install:
#   sudo cp deploy/rampme.service /etc/systemd/system/rampme.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rampme.service
#
# Requires /home/pi/rampme-hardware/.env (gitignored, chmod 600) with
# VEHICLE_ID, MQTT_URL, MQTT_PORT, MQTT_USERNAME, MQTT_PASSWORD, MQTT_TLS.

[Unit]
Description=RampMe Hardware MQTT Client
After=network-online.target
Wants=network-online.target

[Service]
User=pi
Group=pi

WorkingDirectory=/home/pi/rampme-hardware
EnvironmentFile=/home/pi/rampme-hardware/.env

ExecStart=/home/pi/rampme-hardware/venv/bin/python3 server.py

Restart=always
RestartSec=5

StandardOutput=inherit
StandardError=inherit

[Install]
WantedBy=multi-user.target
